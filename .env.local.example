# ERPNext connection — copy this file to `.env.local` and fill in real values.
# Do NOT commit `.env.local` (it is gitignored). In production, set these same
# three variables in Vercel → Settings → Environment Variables.
#
# The site works WITHOUT these — every section falls back to its built-in
# content. Set them to pull live content from ERPNext.

ERPNEXT_URL=https://tlpci.frappe.cloud
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# Create-only ERPNext user for form submissions (Contact, Prayer, Volunteer,
# Plan a Visit, Newsletter → "Website Submission" DocType). SEPARATE from the
# read key above, and create-only. Server-side only — never NEXT_PUBLIC.
# Until set, forms show the thank-you screen but don't store anything.
ERPNEXT_WRITE_API_KEY=your_write_api_key_here
ERPNEXT_WRITE_API_SECRET=your_write_api_secret_here
